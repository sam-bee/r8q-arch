# R8Q audio source-integration additions for Linux 7.1.2.
# Merge after config/r8q_bringup.config. Existing base selections are omitted.
# This fragment contains no firmware names or board calibration values.

# IPC/router and DSP protection-domain discovery.
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_PDR_MSG=m
CONFIG_QCOM_APR=m

# ADSP/PAS closure. The audio device tree leaves CDSP/SLPI disabled; do not add their firmware or drivers here.
CONFIG_QCOM_MDT_LOADER=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m

# RPMSG transport used by PAS/APR/QRTR-SMD.
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_RPMSG_QCOM_SMD=y

# Keep the full QDSP6 closure explicit. q6afe-clocks is built for the exact
# configuration but remains outside the controlled runtime load order.
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_TIMER=m
CONFIG_SND_PCM=m
CONFIG_SND_COMPRESS_OFFLOAD=m
CONFIG_SND_DMAENGINE_PCM=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QCOM_COMMON=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_COMMON=m
CONFIG_SND_SOC_QDSP6_CORE=m
CONFIG_SND_SOC_QDSP6_AFE=m
CONFIG_SND_SOC_QDSP6_AFE_DAI=m
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=m
CONFIG_SND_SOC_QDSP6_ADM=m
CONFIG_SND_SOC_QDSP6_ROUTING=m
CONFIG_SND_SOC_QDSP6_ASM=m
CONFIG_SND_SOC_QDSP6_ASM_DAI=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_QDSP6_PRM=m
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=m
CONFIG_SND_SOC_QDSP6_USB=m
CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS=m

# Canonical upstream Cirrus codec closure. The CS35L41 codec source itself is
# not copied here; current RTC2 modules are built from exact source separately.
CONFIG_FW_CS_DSP=m
CONFIG_SND_SOC_WM_ADSP=m
CONFIG_SND_SOC_CS35L41_LIB=m
CONFIG_SND_SOC_CS35L41=m
CONFIG_SND_SOC_CS35L41_I2C=m

# In-tree machine driver added by patches/0010.
CONFIG_SND_SOC_R8Q_CS35L41=m
