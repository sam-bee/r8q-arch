# Reviewed environment for the bounded alarm-user session. The primary
# runner should import these values without changing /etc or the boot stack.
OMARCHY_PATH=/usr/share/omarchy
AQ_DRM_DEVICES=/dev/dri/by-path/platform-9c000000.framebuffer-card
LIBSEAT_BACKEND=seatd
XDG_CURRENT_DESKTOP=Hyprland
XDG_SESSION_DESKTOP=Hyprland
XDG_SESSION_TYPE=wayland
