From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: r8q audio integration <offline-build>
Date: Sat, 10 Oct 2026 00:00:00 +0100
Subject: [PATCH] ASoC: qcom: preserve r8q Q6AFE TDM fields

This is a canonical standalone source patch for the exact Linux 7.1.2
r8q-rtc2 source. It contains no firmware or factory calibration payload.
---
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -1362,6 +1362,9 @@
 	pcfg->tdm_cfg.sync_mode = cfg->sync_mode;
 	pcfg->tdm_cfg.sync_src = cfg->sync_src;
 	pcfg->tdm_cfg.nslots_per_frame = cfg->nslots_per_frame;
+	pcfg->tdm_cfg.ctrl_data_out_enable = cfg->ctrl_data_out_enable;
+	pcfg->tdm_cfg.ctrl_invert_sync_pulse = cfg->ctrl_invert_sync_pulse;
+	pcfg->tdm_cfg.ctrl_sync_data_delay = cfg->ctrl_sync_data_delay;
 
 	pcfg->tdm_cfg.slot_width = cfg->slot_width;
 	pcfg->tdm_cfg.slot_mask = cfg->slot_mask;
@@ -1677,8 +1680,9 @@
 				       AFE_MODULE_AUDIO_DEV_INTERFACE,
 				       sizeof(port->port_cfg));
 	if (ret) {
-		dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
-			port_id, ret);
+		dev_err(afe->dev,
+			"AFE parameter for port 0x%x param 0x%x module 0x%x failed %d\n",
+			port_id, param_id, AFE_MODULE_AUDIO_DEV_INTERFACE, ret);
 		return ret;
 	}
 
@@ -1687,8 +1691,10 @@
 					AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG,
 					AFE_MODULE_TDM, sizeof(*port->scfg));
 		if (ret) {
-			dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
-			port_id, ret);
+			dev_err(afe->dev,
+				"AFE TDM slot map for port 0x%x param 0x%x module 0x%x failed %d\n",
+				port_id, AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG,
+				AFE_MODULE_TDM, ret);
 			return ret;
 		}
 	}
--- a/sound/soc/qcom/qdsp6/q6afe-dai.c
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c
@@ -278,6 +278,9 @@
 	tdm->data_align_type = dai_data->priv[dai->id].data_align;
 	tdm->sync_src = dai_data->priv[dai->id].sync_src;
 	tdm->sync_mode = dai_data->priv[dai->id].sync_mode;
+	tdm->ctrl_data_out_enable = dai_data->priv[dai->id].data_out_enable;
+	tdm->ctrl_invert_sync_pulse = dai_data->priv[dai->id].invert_sync;
+	tdm->ctrl_sync_data_delay = dai_data->priv[dai->id].data_delay;
 
 	return 0;
 }
--- a/sound/soc/qcom/qdsp6/q6afe.h
+++ b/sound/soc/qcom/qdsp6/q6afe.h
@@ -190,6 +190,9 @@
 	u16	sync_mode;
 	u16	sync_src;
 	u16	nslots_per_frame;
+	u16	ctrl_data_out_enable;
+	u16	ctrl_invert_sync_pulse;
+	u16	ctrl_sync_data_delay;
 	u16	slot_width;
 	u16	slot_mask;
 	u32	data_align_type;
