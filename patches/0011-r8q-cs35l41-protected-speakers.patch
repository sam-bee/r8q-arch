+					CS35L41_BST_IPK_MASK << CS35L41_BST_IPK_SHIFT,
+					ipk << CS35L41_BST_IPK_SHIFT);
+	} else {
+		ret = cs35l41_init_boost(cs35l41->dev, cs35l41->regmap,
+					 &cs35l41->hw_cfg);
+	}
+	if (ret)
+		return ret;
+
+	if (cs35l41->r8q_audio_path) {
+		/* DAPM stays powered across runtime PM; reapply before next unmute. */
+		mutex_lock(&cs35l41->r8q_audio_lock);
+		ret = cs35l41_r8q_force_mute(cs35l41);
+		mutex_unlock(&cs35l41->r8q_audio_lock);
+		if (ret)
+			return ret;
+
+		ret = cs35l41_r8q_apply_factory_cal(cs35l41);
+		if (ret)
+			return ret;
+	}
 
 	return 0;
 }
