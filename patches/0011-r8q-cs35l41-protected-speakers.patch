+/* Keep the ALSA-selected volume independent from the temporary mute value. */
+static int cs35l41_r8q_pcm_volume_get(struct snd_kcontrol *kcontrol,
+					      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct cs35l41_private *cs35l41 = snd_soc_component_get_drvdata(component);
+
+	if (!cs35l41->r8q_audio_path)
+		return snd_soc_get_volsw_sx(kcontrol, ucontrol);
+
+	mutex_lock(&cs35l41->r8q_audio_lock);
+	/* An initial hardware mute sentinel is not a selected ALSA value. */
+	ucontrol->value.integer.value[0] =
+		cs35l41->r8q_pcm_vol_ctl_valid ? cs35l41->r8q_pcm_vol_ctl : 0;
+	mutex_unlock(&cs35l41->r8q_audio_lock);
+
+	return 0;
+}
+
+static int cs35l41_r8q_pcm_volume_put(struct snd_kcontrol *kcontrol,
+						      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct cs35l41_private *cs35l41 = snd_soc_component_get_drvdata(component);
+	unsigned int val, old_ctl;
+	long ctl = ucontrol->value.integer.value[0];
+	bool old_valid, changed_ctl;
+	int ret, changed;
+
+	if (!cs35l41->r8q_audio_path)
+		return snd_soc_put_volsw_sx(kcontrol, ucontrol);
+	if (ctl < 0 || ctl > 0x391)
+		return -EINVAL;
+
+	mutex_lock(&cs35l41->r8q_audio_lock);
+	old_ctl = cs35l41->r8q_pcm_vol_ctl;
+	old_valid = cs35l41->r8q_pcm_vol_ctl_valid;
+	changed_ctl = !old_valid || old_ctl != ctl;
+
+	if (cs35l41->r8q_output_muted) {
+		/* Keep the vendor mute sentinel in hardware while muted. */
+		ret = regmap_update_bits(cs35l41->regmap,
+			CS35L41_AMP_DIG_VOL_CTRL,
+			CS35L41_AMP_VOL_PCM_MASK << CS35L41_AMP_VOL_PCM_SHIFT,
+			CS35L41_AMP_VOL_PCM_MUTE << CS35L41_AMP_VOL_PCM_SHIFT);
+		if (ret < 0)
+			goto fail_mute;
+
+		cs35l41->r8q_pcm_vol_ctl = ctl;
+		cs35l41->r8q_pcm_vol_ctl_valid = true;
+		cs35l41->r8q_pcm_vol_reg =
+			cs35l41_r8q_volume_ctl_to_reg(ctl);
+		cs35l41->r8q_pcm_vol_valid = true;
+		ret = changed_ctl;
+		goto out;
+	}
+
+	changed = snd_soc_put_volsw_sx(kcontrol, ucontrol);
+	if (changed < 0) {
+		ret = changed;
+		goto out;
+	}
+
+	ret = regmap_read(cs35l41->regmap, CS35L41_AMP_DIG_VOL_CTRL, &val);
+	if (ret)
+		goto fail_mute;
+
+	cs35l41->r8q_pcm_vol_reg = (val >> CS35L41_AMP_VOL_PCM_SHIFT) &
+		CS35L41_AMP_VOL_PCM_MASK;
+	cs35l41->r8q_pcm_vol_valid = true;
+	cs35l41->r8q_pcm_vol_ctl = ctl;
+	cs35l41->r8q_pcm_vol_ctl_valid = true;
+	ret = changed || changed_ctl;
+	goto out;
+
+fail_mute:
+	cs35l41_r8q_force_mute(cs35l41);
+out:
+	mutex_unlock(&cs35l41->r8q_audio_lock);
+	return ret;
+}
