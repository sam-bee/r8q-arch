+STATIC
+EFI_STATUS
+R8qRunDiscovery (
+  VOID
+  )
+{
+  EFI_STATUS                         Status;
+  EFI_STATUS                         FileStatus;
+  EFI_HANDLE                         *BlockHandles;
+  EFI_HANDLE                         *PartitionHandles;
+  EFI_HANDLE                         *SfsHandles;
+  UINTN                              BlockCount;
+  UINTN                              PartitionCount;
+  UINTN                              SfsCount;
+  UINTN                              Index;
+  UINTN                              StoredWholeCount;
+  UINTN                              WholeCount;
+  UINTN                              CachePartitionCount;
+  UINTN                              CacheHardDriveCount;
+  UINTN                              CacheSfsCount;
+  UINTN                              StoredFileCount;
+  UINTN                              Omitted;
+  UINTN                              NonUsbSfsCount;
+  UINTN                              NoPathSfsCount;
+  UINTN                              Printed;
+  BOOLEAN                            AbortToMenu;
+  EFI_BLOCK_IO_PROTOCOL              *BlockIo;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL    *FileSystem;
+  EFI_DEVICE_PATH_PROTOCOL           *DevicePath;
+  R8Q_WHOLE_BLOCK                    WholeBlocks[R8Q_DISCOVERY_MAX_WHOLE];
+  R8Q_CACHE_MATCH                    CacheMatch;
+  R8Q_CACHE_MATCH                    FirstCacheMatch;
+  R8Q_CACHE_FILE_RESULT              CacheFiles[R8Q_DISCOVERY_MAX_CACHE_SFS];
+  R8Q_PAGE                           Page;
+  CHAR16                             Label[13];
+
+  BlockHandles       = NULL;
+  PartitionHandles   = NULL;
+  SfsHandles         = NULL;
+  BlockCount         = 0;
+  PartitionCount     = 0;
+  SfsCount           = 0;
+  StoredWholeCount   = 0;
+  WholeCount         = 0;
+  CachePartitionCount = 0;
+  CacheHardDriveCount = 0;
+  CacheSfsCount      = 0;
+  StoredFileCount    = 0;
+  NonUsbSfsCount     = 0;
+  NoPathSfsCount      = 0;
+  ZeroMem (WholeBlocks, sizeof (WholeBlocks));
+  ZeroMem (&FirstCacheMatch, sizeof (FirstCacheMatch));
+  ZeroMem (CacheFiles, sizeof (CacheFiles));
+
+  if ((gST == NULL) || (gST->ConIn == NULL) || (gST->ConOut == NULL)) {
+    return EFI_NOT_READY;
+  }
+
+  Status = gBS->SetWatchdogTimer (0, 0, 0, NULL);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = R8qDrainDiagnosticInput ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiBlockIoProtocolGuid,
+                  NULL,
+                  &BlockCount,
+                  &BlockHandles
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    BlockCount   = 0;
+    BlockHandles = NULL;
+  } else if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiPartitionInfoProtocolGuid,
+                  NULL,
+                  &PartitionCount,
+                  &PartitionHandles
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    PartitionCount     = 0;
+    PartitionHandles   = NULL;
+  } else if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  for (Index = 0; Index < BlockCount; Index++) {
+    BlockIo = NULL;
+    Status  = gBS->HandleProtocol (
+                     BlockHandles[Index],
+                     &gEfiBlockIoProtocolGuid,
+                     (VOID **)&BlockIo
+                     );
+    if (EFI_ERROR (Status) || (BlockIo == NULL) || (BlockIo->Media == NULL)) {
+      if (!EFI_ERROR (Status)) {
+        Status = EFI_DEVICE_ERROR;
+      }
+
+      goto Done;
+    }
+
+    if (!BlockIo->Media->LogicalPartition) {
+      WholeCount++;
+      if (StoredWholeCount < R8Q_DISCOVERY_MAX_WHOLE) {
+        WholeBlocks[StoredWholeCount].BlockSize       = BlockIo->Media->BlockSize;
+        WholeBlocks[StoredWholeCount].LastBlock       = BlockIo->Media->LastBlock;
+        WholeBlocks[StoredWholeCount].RemovableMedia  = BlockIo->Media->RemovableMedia;
+        WholeBlocks[StoredWholeCount].MediaPresent    = BlockIo->Media->MediaPresent;
+        WholeBlocks[StoredWholeCount].ReadOnly        = BlockIo->Media->ReadOnly;
+        DevicePath = DevicePathFromHandle (BlockHandles[Index]);
+        WholeBlocks[StoredWholeCount].HasUfsPath = R8qGetUfsPath (
+                                                   DevicePath,
+                                                   &WholeBlocks[StoredWholeCount].UfsPun,
+                                                   &WholeBlocks[StoredWholeCount].UfsLun
+                                                   );
+        StoredWholeCount++;
+      }
+    }
+
+    if (R8qIsCacheHandle (BlockHandles[Index], &CacheMatch)) {
+      if (CacheMatch.FromPartitionInfo) {
+        CachePartitionCount++;
+        if (CachePartitionCount == 1) {
+          CopyMem (&FirstCacheMatch, &CacheMatch, sizeof (FirstCacheMatch));
+        }
+      }
+
+      if (CacheMatch.FromHardDrivePath) {
+        CacheHardDriveCount++;
+      }
+    }
+  }
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &SfsCount,
+                  &SfsHandles
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    SfsCount   = 0;
+    SfsHandles = NULL;
+  } else if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  for (Index = 0; Index < SfsCount; Index++) {
+    DevicePath = DevicePathFromHandle (SfsHandles[Index]);
+    if (DevicePath == NULL) {
+      NoPathSfsCount++;
+    } else if (!IsDevicePathUSB (DevicePath)) {
+      NonUsbSfsCount++;
+    }
+
+    FileSystem = NULL;
+    Status     = gBS->HandleProtocol (
+                         SfsHandles[Index],
+                         &gEfiSimpleFileSystemProtocolGuid,
+                         (VOID **)&FileSystem
+                         );
+    if (EFI_ERROR (Status) || (FileSystem == NULL)) {
+      if (!EFI_ERROR (Status)) {
+        Status = EFI_DEVICE_ERROR;
+      }
+
+      goto Done;
+    }
+
+    if (R8qIsCacheHandle (SfsHandles[Index], &CacheMatch)) {
+      CacheSfsCount++;
+      if (StoredFileCount < R8Q_DISCOVERY_MAX_CACHE_SFS) {
+        FileStatus = R8qInspectCacheVolume (FileSystem, &CacheFiles[StoredFileCount]);
+        if (EFI_ERROR (FileStatus)) {
+          Status = FileStatus;
+          goto Done;
+        }
+
+        StoredFileCount++;
+      }
+    }
+  }
+
+  Status = R8qOpenDiagnosticPage (L"Internal storage / Block I/O", &Page);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Omitted = 0;
+  Status  = R8qPrintDiagnosticLine (&Page, &Omitted, L"BLK %u whole %u", BlockCount, WholeCount);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Printed = StoredWholeCount;
+  for (Index = 0; Index < Printed; Index++) {
+    if (WholeBlocks[Index].HasUfsPath) {
+      Status = R8qPrintDiagnosticLine (
+                 &Page,
+                 &Omitted,
+                 L"W%u sz%u last%Lu M%u P%u R%u U%u/%u",
+                 Index,
+                 WholeBlocks[Index].BlockSize,
+                 WholeBlocks[Index].LastBlock,
+                 WholeBlocks[Index].RemovableMedia,
+                 WholeBlocks[Index].MediaPresent,
+                 WholeBlocks[Index].ReadOnly,
+                 WholeBlocks[Index].UfsPun,
+                 WholeBlocks[Index].UfsLun
+                 );
+    } else {
+      Status = R8qPrintDiagnosticLine (
+                 &Page,
+                 &Omitted,
+                 L"W%u sz%u last%Lu M%u P%u R%u U--",
+                 Index,
+                 WholeBlocks[Index].BlockSize,
+                 WholeBlocks[Index].LastBlock,
+                 WholeBlocks[Index].RemovableMedia,
+                 WholeBlocks[Index].MediaPresent,
+                 WholeBlocks[Index].ReadOnly
+                 );
+    }
+
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  if (WholeCount > Printed) {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"+%u whole omitted", WholeCount - Printed);
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  Status = R8qPrintDiagnosticLine (
+             &Page,
+             &Omitted,
+             L"PI %u C%u H%u",
+             PartitionCount,
+             CachePartitionCount,
+             CacheHardDriveCount
+             );
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  if (CachePartitionCount > 0) {
+    CopyMem (Label, FirstCacheMatch.Label, sizeof (Label));
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"C %s %Lu-%Lu a%Lx",
+               Label,
+               FirstCacheMatch.StartLba,
+               FirstCacheMatch.EndLba,
+               FirstCacheMatch.Attributes
+               );
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"C disk sz%u last%Lu",
+               FirstCacheMatch.BlockSize,
+               FirstCacheMatch.LastBlock
+               );
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  if (Omitted > 0) {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"+%u lines omitted", Omitted);
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  Status = R8qWaitForDiagnosticAction (&AbortToMenu);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  if (AbortToMenu) {
+    Status = EFI_ABORTED;
+    goto Done;
+  }
+
+  Status = R8qOpenDiagnosticPage (L"Simple File System / boot file", &Page);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Omitted = 0;
+  Status  = R8qPrintDiagnosticLine (
+              &Page,
+              &Omitted,
+              L"SFS %u nonUSB %u noPath %u",
+              SfsCount,
+              NonUsbSfsCount,
+              NoPathSfsCount
+              );
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"CACHE SFS %u", CacheSfsCount);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  for (Index = 0; Index < StoredFileCount; Index++) {
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"C%u vol %r open %r",
+               Index,
+               CacheFiles[Index].VolumeStatus,
+               CacheFiles[Index].OpenStatus
+               );
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+
+    if (CacheFiles[Index].FileSizeValid) {
+      Status = R8qPrintDiagnosticLine (
+                 &Page,
+                 &Omitted,
+                 L"C%u info %r size %Lu",
+                 Index,
+                 CacheFiles[Index].InfoStatus,
+                 CacheFiles[Index].FileSize
+                 );
+    } else {
+      Status = R8qPrintDiagnosticLine (
+                 &Page,
+                 &Omitted,
+                 L"C%u info %r size --",
+                 Index,
+                 CacheFiles[Index].InfoStatus
+                 );
+    }
+
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  if (CacheSfsCount > StoredFileCount) {
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"+%u CACHE SFS uninspected",
+               CacheSfsCount - StoredFileCount
+               );
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"Other SFS: metadata only");
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  if (Omitted > 0) {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"+%u lines omitted", Omitted);
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+  Status = R8qWaitForDiagnosticAction (&AbortToMenu);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  if (AbortToMenu) {
+    Status = EFI_ABORTED;
+  }
+
+Done:
+  if (BlockHandles != NULL) {
+    FreePool (BlockHandles);
+  }
+
+  if (PartitionHandles != NULL) {
+    FreePool (PartitionHandles);
+  }
+
+  if (SfsHandles != NULL) {
+    FreePool (SfsHandles);
+  }
+
+  return Status;
+}
