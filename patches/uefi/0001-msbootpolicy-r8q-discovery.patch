+STATIC
+EFI_STATUS
+R8qOpenDiagnosticPage (
+  IN  CONST CHAR16  *Title,
+  OUT R8Q_PAGE      *Page
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       Columns;
+  UINTN       Rows;
+
+  if ((Title == NULL) || (Page == NULL) || (gST == NULL) ||
+      (gST->ConOut == NULL) || (gST->ConOut->Mode == NULL))
+  {
+    return EFI_NOT_READY;
+  }
+
+  Status = gST->ConOut->QueryMode (
+                                  gST->ConOut,
+                                  gST->ConOut->Mode->Mode,
+                                  &Columns,
+                                  &Rows
+                                  );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if ((Columns <= R8Q_DISCOVERY_PAGE_COLUMNS) || (Rows < R8Q_DISCOVERY_MIN_ROWS)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Status = gST->ConOut->ClearScreen (gST->ConOut);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Page->Rows      = 0;
+  Page->TotalRows = Rows;
+  Status = gST->ConOut->OutputString (gST->ConOut, L"R8Q discovery\r\n");
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Page->Rows++;
+  Status = gST->ConOut->OutputString (gST->ConOut, (CHAR16 *)Title);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gST->ConOut->OutputString (gST->ConOut, L"\r\n");
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Page->Rows++;
+  Status = gST->ConOut->OutputString (gST->ConOut, L"CR next  Up menu\r\n");
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Page->Rows++;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+R8qPrintDiagnosticText (
+  IN OUT R8Q_PAGE      *Page,
+  IN     CONST CHAR16  *Text
+  )
+{
+  EFI_STATUS  Status;
+
+  if ((Page == NULL) || (Text == NULL) || (gST == NULL) ||
+      (gST->ConOut == NULL) || (gST->ConOut->Mode == NULL))
+  {
+    return EFI_NOT_READY;
+  }
+
+  if ((Page->Rows + 1) >= Page->TotalRows) {
+    return EFI_BUFFER_TOO_SMALL;
+  }
+
+  if (StrLen (Text) > R8Q_DISCOVERY_PAGE_COLUMNS) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  Status = gST->ConOut->OutputString (gST->ConOut, (CHAR16 *)Text);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gST->ConOut->OutputString (gST->ConOut, L"\r\n");
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Page->Rows++;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+R8qPrintDiagnosticLine (
+  IN OUT R8Q_PAGE      *Page,
+  IN OUT UINTN         *Omitted,
+  IN     CONST CHAR16  *Format,
+  ...
+  )
+{
+  VA_LIST     Marker;
+  CHAR16      Buffer[128];
+  EFI_STATUS  Status;
+
+  if ((Page == NULL) || (Omitted == NULL) || (Format == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  VA_START (Marker, Format);
+  UnicodeVSPrint (Buffer, sizeof (Buffer), Format, Marker);
+  VA_END (Marker);
+
+  Status = R8qPrintDiagnosticText (Page, Buffer);
+  if (Status == EFI_BUFFER_TOO_SMALL) {
+    (*Omitted)++;
+    return EFI_SUCCESS;
+  }
+
+  return Status;
+}
