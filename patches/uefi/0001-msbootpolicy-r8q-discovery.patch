+STATIC
+BOOLEAN
+R8qGetUfsPath (
+  IN  EFI_DEVICE_PATH_PROTOCOL  *DevicePath,
+  OUT UINT8                     *Pun,
+  OUT UINT8                     *Lun
+  )
+{
+  if ((DevicePath == NULL) || !IsDevicePathValid (DevicePath, 0) ||
+      (Pun == NULL) || (Lun == NULL))
+  {
+    return FALSE;
+  }
+
+  for (;;) {
+    if (DevicePath == NULL ||
+        DevicePathNodeLength (DevicePath) < sizeof (EFI_DEVICE_PATH_PROTOCOL))
+    {
+      return FALSE;
+    }
+
+    if (IsDevicePathEndType (DevicePath)) {
+      break;
+    }
+
+    if ((DevicePathType (DevicePath) == MESSAGING_DEVICE_PATH) &&
+        (DevicePathSubType (DevicePath) == MSG_UFS_DP) &&
+        (DevicePathNodeLength (DevicePath) >= sizeof (UFS_DEVICE_PATH)))
+    {
+      *Pun = ((UFS_DEVICE_PATH *)DevicePath)->Pun;
+      *Lun = ((UFS_DEVICE_PATH *)DevicePath)->Lun;
+      return TRUE;
+    }
+
+    DevicePath = NextDevicePathNode (DevicePath);
+  }
+
+  return FALSE;
+}
+
+STATIC
+BOOLEAN
+R8qGetCacheHardDrivePath (
+  IN EFI_DEVICE_PATH_PROTOCOL  *DevicePath
+  )
+{
+  HARDDRIVE_DEVICE_PATH  *HardDrive;
+
+  if ((DevicePath == NULL) || !IsDevicePathValid (DevicePath, 0)) {
+    return FALSE;
+  }
+
+  for (;;) {
+    if (DevicePath == NULL ||
+        DevicePathNodeLength (DevicePath) < sizeof (EFI_DEVICE_PATH_PROTOCOL))
+    {
+      return FALSE;
+    }
+
+    if (IsDevicePathEndType (DevicePath)) {
+      break;
+    }
+
+    if ((DevicePathType (DevicePath) == MEDIA_DEVICE_PATH) &&
+        (DevicePathSubType (DevicePath) == MEDIA_HARDDRIVE_DP) &&
+        (DevicePathNodeLength (DevicePath) >= sizeof (HARDDRIVE_DEVICE_PATH)))
+    {
+      HardDrive = (HARDDRIVE_DEVICE_PATH *)DevicePath;
+      if ((HardDrive->MBRType == MBR_TYPE_EFI_PARTITION_TABLE_HEADER) &&
+          (HardDrive->SignatureType == SIGNATURE_TYPE_GUID) &&
+          (CompareMem (HardDrive->Signature, &mR8qCachePartitionGuid, sizeof (EFI_GUID)) == 0) &&
+          (HardDrive->PartitionStart == R8Q_DISCOVERY_CACHE_START_LBA) &&
+          (HardDrive->PartitionSize == R8Q_DISCOVERY_CACHE_BLOCKS))
+      {
+        return TRUE;
+      }
+    }
+
+    DevicePath = NextDevicePathNode (DevicePath);
+  }
+
+  return FALSE;
+}
+
+STATIC
+VOID
+R8qCopyPartitionLabel (
+  OUT CHAR16                       *Destination,
+  IN  EFI_PARTITION_INFO_PROTOCOL  *PartitionInfo
+  )
+{
+  if ((Destination == NULL) || (PartitionInfo == NULL)) {
+    return;
+  }
+
+  CopyMem (Destination, PartitionInfo->Info.Gpt.PartitionName, 12 * sizeof (CHAR16));
+  Destination[12] = L'\0';
+}
+
+STATIC
+BOOLEAN
+R8qIsCacheHandle (
+  IN  EFI_HANDLE       Handle,
+  OUT R8Q_CACHE_MATCH  *Match
+  )
+{
+  EFI_STATUS                    Status;
+  EFI_STATUS                    BlockStatus;
+  EFI_PARTITION_INFO_PROTOCOL   *PartitionInfo;
+  EFI_BLOCK_IO_PROTOCOL         *BlockIo;
+  UINT8                          Pun;
+  UINT8                          Lun;
+
+  if (Match == NULL) {
+    return FALSE;
+  }
+
+  ZeroMem (Match, sizeof (*Match));
+  if (R8qGetUfsPath (DevicePathFromHandle (Handle), &Pun, &Lun) && (Lun != 0)) {
+    return FALSE;
+  }
+
+  PartitionInfo = NULL;
+  BlockIo       = NULL;
+  Status = gBS->HandleProtocol (
+                  Handle,
+                  &gEfiPartitionInfoProtocolGuid,
+                  (VOID **)&PartitionInfo
+                  );
+  BlockStatus = gBS->HandleProtocol (
+                  Handle,
+                  &gEfiBlockIoProtocolGuid,
+                  (VOID **)&BlockIo
+                  );
+  if (!EFI_ERROR (BlockStatus) && (BlockIo != NULL) && (BlockIo->Media != NULL)) {
+    Match->BlockSize = BlockIo->Media->BlockSize;
+    Match->LastBlock = BlockIo->Media->LastBlock;
+  }
+
+  if (!EFI_ERROR (Status) && (PartitionInfo != NULL) &&
+      (PartitionInfo->Type == PARTITION_TYPE_GPT) &&
+      CompareGuid (&PartitionInfo->Info.Gpt.PartitionTypeGUID, &mR8qCachePartitionGuid) &&
+      CompareGuid (&PartitionInfo->Info.Gpt.UniquePartitionGUID, &mR8qCachePartitionGuid) &&
+      (PartitionInfo->Info.Gpt.StartingLBA == R8Q_DISCOVERY_CACHE_START_LBA) &&
+      (PartitionInfo->Info.Gpt.EndingLBA == R8Q_DISCOVERY_CACHE_END_LBA))
+  {
+    Match->FromPartitionInfo = TRUE;
+    Match->StartLba          = PartitionInfo->Info.Gpt.StartingLBA;
+    Match->EndLba            = PartitionInfo->Info.Gpt.EndingLBA;
+    Match->Attributes        = PartitionInfo->Info.Gpt.Attributes;
+    R8qCopyPartitionLabel (Match->Label, PartitionInfo);
+    return TRUE;
+  }
+
+  if (R8qGetCacheHardDrivePath (DevicePathFromHandle (Handle))) {
+    Match->FromHardDrivePath = TRUE;
+    Match->StartLba          = R8Q_DISCOVERY_CACHE_START_LBA;
+    Match->EndLba            = R8Q_DISCOVERY_CACHE_END_LBA;
+    CopyMem (Match->Label, L"hd-path", sizeof (L"hd-path"));
+    return TRUE;
+  }
+
+  return FALSE;
+}
