+STATIC
+EFI_STATUS
+R8qDrainDiagnosticInput (
+  VOID
+  )
+{
+  EFI_STATUS      Status;
+  EFI_EVENT       QuietEvent;
+  EFI_EVENT       MaxEvent;
+  EFI_EVENT       Events[3];
+  UINTN           EventIndex;
+  EFI_INPUT_KEY   Key;
+
+  if ((gST == NULL) || (gST->ConIn == NULL)) {
+    return EFI_NOT_READY;
+  }
+
+  QuietEvent = NULL;
+  MaxEvent   = NULL;
+  Status     = gBS->CreateEvent (EVT_TIMER, TPL_NOTIFY, NULL, NULL, &QuietEvent);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gBS->CreateEvent (EVT_TIMER, TPL_NOTIFY, NULL, NULL, &MaxEvent);
+  if (EFI_ERROR (Status)) {
+    gBS->CloseEvent (QuietEvent);
+    return Status;
+  }
+
+  Events[0] = gST->ConIn->WaitForKey;
+  Events[1] = QuietEvent;
+  Events[2] = MaxEvent;
+  Status = gBS->SetTimer (QuietEvent, TimerRelative, R8Q_DISCOVERY_QUIET_100NS);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  Status = gBS->SetTimer (MaxEvent, TimerRelative, R8Q_DISCOVERY_DRAIN_MAX_100NS);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  for (;;) {
+    Status = gBS->CheckEvent (MaxEvent);
+    if (Status == EFI_SUCCESS) {
+      Status = EFI_TIMEOUT;
+      goto Done;
+    }
+
+    if (Status != EFI_NOT_READY) {
+      goto Done;
+    }
+
+    Status = gBS->WaitForEvent (ARRAY_SIZE (Events), Events, &EventIndex);
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+
+    if (EventIndex == 1) {
+      Status = EFI_SUCCESS;
+      goto Done;
+    }
+
+    if (EventIndex == 2) {
+      Status = EFI_TIMEOUT;
+      goto Done;
+    }
+
+    Status = gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
+    if (Status == EFI_NOT_READY) {
+      continue;
+    }
+
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+
+    if (Key.ScanCode == SCAN_UP) {
+      Status = EFI_ABORTED;
+      goto Done;
+    }
+
+    Status = gBS->SetTimer (QuietEvent, TimerRelative, R8Q_DISCOVERY_QUIET_100NS);
+    if (EFI_ERROR (Status)) {
+      goto Done;
+    }
+  }
+
+Done:
+  gBS->CloseEvent (QuietEvent);
+  gBS->CloseEvent (MaxEvent);
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+R8qWaitForDiagnosticAction (
+  OUT BOOLEAN  *AbortToMenu
+  )
+{
+  EFI_STATUS      Status;
+  EFI_INPUT_KEY   Key;
+  UINTN           EventIndex;
+
+  if ((AbortToMenu == NULL) || (gST == NULL) || (gST->ConIn == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *AbortToMenu = FALSE;
+  for (;;) {
+    Status = gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &EventIndex);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    Status = gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
+    if (Status == EFI_NOT_READY) {
+      continue;
+    }
+
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    if (Key.ScanCode == SCAN_UP) {
+      *AbortToMenu = TRUE;
+      return EFI_ABORTED;
+    }
+
+    if (Key.UnicodeChar == CHAR_CARRIAGE_RETURN) {
+      return R8qDrainDiagnosticInput ();
+    }
+  }
+}
