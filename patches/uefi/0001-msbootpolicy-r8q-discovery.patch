+STATIC
+EFI_STATUS
+R8qShowBootResultPage (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_STATUS  PageStatus;
+  BOOLEAN     AbortToMenu;
+  UINTN       Omitted;
+  UINTN       Index;
+  R8Q_PAGE    Page;
+
+  Status = gBS->SetWatchdogTimer (0, 0, 0, NULL);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = R8qOpenDiagnosticPage (L"Boot result", &Page);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Omitted = 0;
+  Status  = R8qPrintDiagnosticLine (
+              &Page,
+              &Omitted,
+              L"select %r nohandles %u",
+              mR8qFinalSelectionStatus,
+              mR8qNoHandlesAfterFilter
+              );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"select code 0x%Lx", (UINT64)mR8qFinalSelectionStatus);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (mR8qBootOptionStatusValid) {
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"boot %r",
+               mR8qLastBootOptionStatus
+               );
+  } else {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"boot not called");
+  }
+
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (mR8qBootAttemptCount == 0) {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"attempts none");
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  for (Index = 0; Index < mR8qBootAttemptCount; Index++) {
+    if ((Page.Rows + 1) >= Page.TotalRows) {
+      PageStatus = R8qWaitForDiagnosticAction (&AbortToMenu);
+      if (EFI_ERROR (PageStatus) || AbortToMenu) {
+        return EFI_ABORTED;
+      }
+
+      Status = R8qOpenDiagnosticPage (L"Boot candidate status", &Page);
+      if (EFI_ERROR (Status)) {
+        return Status;
+      }
+    }
+
+    Status = R8qPrintDiagnosticLine (
+               &Page,
+               &Omitted,
+               L"try%u C%u %r 0x%Lx",
+               mR8qBootAttempts[Index].Candidate,
+               mR8qBootAttempts[Index].IsCache,
+               mR8qBootAttempts[Index].Status,
+               (UINT64)mR8qBootAttempts[Index].Status
+               );
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  if (Omitted > 0) {
+    Status = R8qPrintDiagnosticLine (&Page, &Omitted, L"+%u lines omitted", Omitted);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  PageStatus = R8qWaitForDiagnosticAction (&AbortToMenu);
+  if (EFI_ERROR (PageStatus)) {
+    return PageStatus;
+  }
+
+  if (AbortToMenu) {
+    return EFI_ABORTED;
+  }
+
+  return EFI_SUCCESS;
+}
