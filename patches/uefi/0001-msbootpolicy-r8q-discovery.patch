+STATIC
+EFI_STATUS
+R8qInspectCacheVolume (
+  IN  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *FileSystem,
+  OUT R8Q_CACHE_FILE_RESULT            *Result
+  )
+{
+  EFI_STATUS         Status;
+  EFI_FILE_PROTOCOL  *Root;
+  EFI_FILE_PROTOCOL  *File;
+  EFI_FILE_INFO      *FileInfo;
+  UINTN              InfoSize;
+
+  if ((FileSystem == NULL) || (Result == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  ZeroMem (Result, sizeof (*Result));
+  Result->VolumeStatus = EFI_NOT_READY;
+  Result->OpenStatus   = EFI_NOT_READY;
+  Result->InfoStatus   = EFI_NOT_READY;
+  Root                = NULL;
+  File                = NULL;
+  FileInfo            = NULL;
+  InfoSize            = 0;
+
+  Status = FileSystem->OpenVolume (FileSystem, &Root);
+  Result->VolumeStatus = Status;
+  if (EFI_ERROR (Status) || (Root == NULL)) {
+    if (!EFI_ERROR (Status)) {
+      Result->VolumeStatus = EFI_DEVICE_ERROR;
+    }
+
+    goto Done;
+  }
+
+  Status = Root->Open (
+                  Root,
+                  &File,
+                  EFI_REMOVABLE_MEDIA_FILE_NAME,
+                  EFI_FILE_MODE_READ,
+                  0
+                  );
+  Result->OpenStatus = Status;
+  if (EFI_ERROR (Status) || (File == NULL)) {
+    if (!EFI_ERROR (Status)) {
+      Result->OpenStatus = EFI_DEVICE_ERROR;
+    }
+
+    goto Done;
+  }
+
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if ((Status != EFI_BUFFER_TOO_SMALL) ||
+      (InfoSize < sizeof (EFI_FILE_INFO)) ||
+      (InfoSize > R8Q_DISCOVERY_MAX_FILE_INFO))
+  {
+    Result->InfoStatus = (Status == EFI_BUFFER_TOO_SMALL) ? EFI_BAD_BUFFER_SIZE : Status;
+    goto Done;
+  }
+
+  FileInfo = AllocateZeroPool (InfoSize);
+  if (FileInfo == NULL) {
+    Result->InfoStatus = EFI_OUT_OF_RESOURCES;
+    goto Done;
+  }
+
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, FileInfo);
+  Result->InfoStatus = Status;
+  if (!EFI_ERROR (Status)) {
+    if ((InfoSize < sizeof (EFI_FILE_INFO)) || (FileInfo->Size < sizeof (EFI_FILE_INFO)) ||
+        (FileInfo->Size > InfoSize))
+    {
+      Result->InfoStatus = EFI_BAD_BUFFER_SIZE;
+    } else {
+      Result->FileSize      = FileInfo->FileSize;
+      Result->FileSizeValid = TRUE;
+    }
+  }
+
+Done:
+  if (FileInfo != NULL) {
+    FreePool (FileInfo);
+  }
+
+  if (File != NULL) {
+    File->Close (File);
+  }
+
+  if (Root != NULL) {
+    Root->Close (Root);
+  }
+
+  return EFI_SUCCESS;
+}
