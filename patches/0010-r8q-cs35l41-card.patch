From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: r8q audio integration <offline-build>
Date: Sat, 10 Oct 2026 00:00:00 +0100
Subject: [PATCH] ASoC: qcom: add r8q CS35L41 machine driver

This is a canonical standalone source patch for the exact Linux 7.1.2
r8q-rtc2 source. It contains no firmware or factory calibration payload.
---
--- a/sound/soc/qcom/Kconfig
+++ b/sound/soc/qcom/Kconfig
@@ -156,6 +156,17 @@
 	 audio drivers. This includes q6asm, q6adm,
 	 q6afe interfaces to DSP using apr.
 
+config SND_SOC_R8Q_CS35L41
+	tristate "Samsung r8q CS35L41 machine driver"
+	depends on OF
+	depends on I2C
+	depends on SND_SOC_QDSP6
+	depends on SND_SOC_QCOM_COMMON
+	depends on SND_SOC_CS35L41_I2C
+	help
+	  Enable the Samsung SM-G7810/r8q machine driver for a four-slot
+	  primary TDM link feeding two CS35L41 I2C codecs.
+
 config SND_SOC_MSM8996
 	tristate "SoC Machine driver for MSM8996 and APQ8096 boards"
 	depends on QCOM_APR
--- a/sound/soc/qcom/Makefile
+++ b/sound/soc/qcom/Makefile
@@ -42,6 +42,7 @@
 obj-$(CONFIG_SND_SOC_SM8250) += snd-soc-sm8250.o
 obj-$(CONFIG_SND_SOC_QCOM_COMMON) += snd-soc-qcom-common.o
 obj-$(CONFIG_SND_SOC_QCOM_SDW) += snd-soc-qcom-sdw.o
+obj-$(CONFIG_SND_SOC_R8Q_CS35L41) += r8q-cs35l41-card.o
 obj-$(CONFIG_SND_SOC_X1E80100) += snd-soc-x1e80100.o
 obj-$(CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS) += snd-soc-qcom-offload-utils.o
 
--- a/sound/soc/qcom/r8q-cs35l41-card.c
+++ b/sound/soc/qcom/r8q-cs35l41-card.c
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Samsung SM-G7810/r8q CS35L41 TDM machine driver.
+ * Board firmware and factory calibration remain runtime artifacts.
+ */
+
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <sound/cs35l41.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "common.h"
+#include "qdsp6/q6afe.h"
+
+#define R8Q_TDM_BCLK_HZ	6144000
+#define R8Q_TDM_SLOTS	4
+#define R8Q_TDM_SLOT_WIDTH	32
+
+static int r8q_cs35l41_be_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	unsigned int fmt;
+	int i, ret;
+
+	/* LPASS is the TDM clock provider; each CS35 is a bus consumer. */
+	ret = snd_soc_dai_set_sysclk(cpu_dai,
+		Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT, R8Q_TDM_BCLK_HZ,
+		SNDRV_PCM_STREAM_PLAYBACK);
+	if (ret < 0)
+		return ret;
+
+	fmt = SND_SOC_DAIFMT_CBC_CFC | SND_SOC_DAIFMT_DSP_A |
+		SND_SOC_DAIFMT_NB_NF;
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		ret = snd_soc_dai_set_fmt(codec_dai, fmt);
+		if (ret < 0)
+			goto err_disable_cpu_clock;
+
+		/* Program the CS35L41 PLL from the 6.144 MHz ASP bit clock. */
+		ret = snd_soc_component_set_sysclk(codec_dai->component,
+			CS35L41_CLKID_SCLK, 0, R8Q_TDM_BCLK_HZ,
+			SND_SOC_CLOCK_IN);
+		if (ret < 0)
+			goto err_disable_cpu_clock;
+
+		/* CS35L41 uses this to configure its ASP FS monitor. */
+		ret = snd_soc_dai_set_sysclk(codec_dai, 0, R8Q_TDM_BCLK_HZ,
+			SNDRV_PCM_STREAM_PLAYBACK);
+		if (ret < 0)
+			goto err_disable_cpu_clock;
+	}
+
+	return 0;
+
+err_disable_cpu_clock:
+	/* q6afe treats a zero rate as clock disable; unwind partial startup. */
+	snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT, 0,
+		SNDRV_PCM_STREAM_PLAYBACK);
+	return ret;
+}
+
+static void r8q_cs35l41_be_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai,
+		Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT, 0,
+		SNDRV_PCM_STREAM_PLAYBACK);
+	if (ret < 0)
+		dev_err(cpu_dai->dev, "failed to disable primary TDM clock: %d\n", ret);
+}
+
+static int r8q_cs35l41_be_hw_params(struct snd_pcm_substream *substream,
+					struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	/* Q6AFE TDM channel maps use 32-bit byte offsets, not ASP slot IDs. */
+	static const unsigned int rx_slot[] = { 0, 4 };
+	int i, ret;
+
+	if (params_rate(params) != 48000 || params_channels(params) != 2 ||
+	    params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	/* Payload is S16_LE, while the physical ASP frame is four 32-bit slots. */
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, BIT(0) | BIT(1),
+		R8Q_TDM_SLOTS, R8Q_TDM_SLOT_WIDTH);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+		ARRAY_SIZE(rx_slot), rx_slot);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * CS35L41 has set_channel_map, but no set_tdm_slot operation.  The
+	 * DTS codec order is left=0x41 (receiver) then right=0x40 (bottom).
+	 * The stock R8Q card feeds both ASP RX slots to each amp, with the right
+	 * amp swapping them: Left={0,1}, Right={1,0}.
+	 */
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		static const unsigned int left_rx_slot[] = { 0, 1 };
+		static const unsigned int right_rx_slot[] = { 1, 0 };
+		const unsigned int *slots;
+
+		if (i >= 2)
+			return -EINVAL;
+		slots = i ? right_rx_slot : left_rx_slot;
+		ret = snd_soc_dai_set_channel_map(codec_dai, 0, NULL, 2, slots);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int r8q_cs35l41_be_fixup(struct snd_soc_pcm_runtime *rtd,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_interval *rate = hw_param_interval(params,
+		SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_interval *channels = hw_param_interval(params,
+		SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+
+	rate->min = rate->max = 48000;
+	channels->min = channels->max = 2;
+	snd_mask_none(fmt);
+	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	return 0;
+}
+
+static const struct snd_soc_ops r8q_cs35l41_be_ops = {
+	.startup = r8q_cs35l41_be_startup,
+	.shutdown = r8q_cs35l41_be_shutdown,
+	.hw_params = r8q_cs35l41_be_hw_params,
+};
+
+static int r8q_cs35l41_card_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card;
+	struct snd_soc_dai_link *link;
+	int i, ret;
+
+	card = devm_kzalloc(&pdev->dev, sizeof(*card), GFP_KERNEL);
+	if (!card)
+		return -ENOMEM;
+
+	card->owner = THIS_MODULE;
+	card->dev = &pdev->dev;
+	platform_set_drvdata(pdev, card);
+
+	ret = qcom_snd_parse_of(card);
+	if (ret)
+		return ret;
+
+	card->driver_name = "r8q-cs35l41";
+	for_each_card_prelinks(card, i, link) {
+		if (link->no_pcm) {
+			link->ops = &r8q_cs35l41_be_ops;
+			link->be_hw_params_fixup = r8q_cs35l41_be_fixup;
+		}
+	}
+
+	return devm_snd_soc_register_card(&pdev->dev, card);
+}
+
+static const struct of_device_id r8q_cs35l41_of_match[] = {
+	{ .compatible = "samsung,r8q-cs35l41-sndcard" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, r8q_cs35l41_of_match);
+
+static struct platform_driver r8q_cs35l41_card_driver = {
+	.probe = r8q_cs35l41_card_probe,
+	.driver = {
+		.name = "r8q-cs35l41-card",
+		.of_match_table = r8q_cs35l41_of_match,
+	},
+};
+module_platform_driver(r8q_cs35l41_card_driver);
+
+MODULE_DESCRIPTION("SM-G7810/r8q CS35L41 TDM machine driver");
+MODULE_LICENSE("GPL");
