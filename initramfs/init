#!/bin/busybox sh
# r8q ARCH switch_root initramfs.
# UFS + ext4 are BUILT-IN on mainline sm8250, so there is NO module-loading stage
# (unlike garnet). Job: wait for the userdata partition, mount it, and hand PID 1
# to systemd. On ANY failure, bring up the NCM gadget + telnet + an on-screen
# heartbeat so we can debug (display works now, but the phone has no keyboard, so
# the network shell is the real lifeline).

BB=/bin/busybox
$BB --install -s /bin 2>/dev/null
export PATH=/bin HOME=/ TERM=linux

mkdir -p /dev /proc /sys /mnt/esp

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
echo 8 > /proc/sys/kernel/printk 2>/dev/null

echo ""
echo "=================================================="
echo "  r8q ARCH switch_root initramfs — kernel $(uname -r)"
echo "=================================================="

# Find a block device by GPT PARTNAME (from sysfs uevent).
findpart() {
    for u in /sys/class/block/*/uevent; do
        if grep -qi "^PARTNAME=$1\$" "$u" 2>/dev/null; then
            echo "/dev/$($BB basename "$($BB dirname "$u")")"; return 0
        fi
    done
    return 1
}

# Append stdin to a file on OUR ESP (the FAT partition carrying BOOTAA64.EFI).
esp_log() {
    part=$(findpart cache) || return 1
    [ -b "$part" ] || return 1
    mount -t vfat -o sync "$part" /mnt/esp 2>/dev/null || return 1
    if [ ! -f /mnt/esp/EFI/BOOT/BOOTAA64.EFI ]; then
        umount /mnt/esp 2>/dev/null
        return 1
    fi
    mkdir -p /mnt/esp/logs
    cat >> "/mnt/esp/logs/$1"
    sync; umount /mnt/esp 2>/dev/null
}

# NCM gadget + telnet shell — only used on the FAILURE path (Arch's own service
# owns the gadget on success). Wait up to 30s for a UDC, then report one
# distinguishable stage/error without retrying or rebinding an active gadget.
USB_UDC_ROOT=/sys/class/udc
USB_PROC_MOUNTS=/proc/mounts
USB_CONFIGFS_ROOT=/sys/kernel/config
USB_DEVPTS_ROOT=/dev/pts
USB_GADGET=$USB_CONFIGFS_ROOT/usb_gadget/g1
USB_RESULT=not-run
USB_STAGE=not-started
USB_ERROR=none
USB_UDC=none
USB_BOUND=none
USB_NOW_STATE=none

usb_current_state() {
    USB_NOW_UDC=$(ls "$USB_UDC_ROOT" 2>/dev/null | head -1)
    [ -n "$USB_NOW_UDC" ] || USB_NOW_UDC=none
    USB_NOW_BOUND=$(cat "$USB_GADGET/UDC" 2>/dev/null)
    [ -n "$USB_NOW_BOUND" ] || USB_NOW_BOUND=none
    if [ "$USB_NOW_UDC" = none ]; then
        USB_NOW_STATE=none
    else
        USB_NOW_STATE=$(cat "$USB_UDC_ROOT/$USB_NOW_UDC/state" 2>/dev/null)
        [ -n "$USB_NOW_STATE" ] || USB_NOW_STATE=unknown
    fi
}

usb_status() {
    usb_current_state
    echo "USB status: result=$USB_RESULT stage=$USB_STAGE error=$USB_ERROR udc=$USB_NOW_UDC bound=$USB_NOW_BOUND state=$USB_NOW_STATE"
}

usb_hard_fail() {
    USB_RESULT=failed
    USB_ERROR=$1
    echo "USB: stage=$USB_STAGE result=$USB_RESULT error=$USB_ERROR"
    usb_status
}

usb_partial_fail() {
    USB_RESULT=partial
    if [ "$USB_ERROR" = none ]; then
        USB_ERROR=$1
    else
        USB_ERROR="$USB_ERROR,$1"
    fi
    echo "USB: stage=$USB_STAGE result=$USB_RESULT error=$USB_ERROR"
}

usb_write() {
    USB_FILE=$1
    USB_VALUE=$2
    if { echo "$USB_VALUE" > "$USB_FILE"; } 2>/dev/null; then
        return 0
    fi
    USB_ERROR="write-failed:$USB_FILE"
    return 1
}

setup_gadget() {
    USB_STAGE=udc-wait
    USB_RESULT=waiting
    USB_ERROR=none
    USB_UDC=
    USB_WAIT=0
    echo "USB: stage=$USB_STAGE result=$USB_RESULT wait=30s"
    while [ "$USB_WAIT" -le 30 ]; do
        USB_UDC=$(ls "$USB_UDC_ROOT" 2>/dev/null | head -1)
        [ -n "$USB_UDC" ] && break
        [ "$USB_WAIT" -eq 30 ] && break
        sleep 1
        USB_WAIT=$((USB_WAIT + 1))
    done
    if [ -z "$USB_UDC" ]; then
        USB_UDC=none
        USB_STAGE=udc-wait
        USB_RESULT=unavailable
        USB_ERROR="no-udc-after-${USB_WAIT}s"
        echo "USB: stage=$USB_STAGE result=$USB_RESULT error=$USB_ERROR"
        usb_status
        return 1
    fi

    USB_STAGE=configfs-mount
    if grep -q " $USB_CONFIGFS_ROOT configfs " "$USB_PROC_MOUNTS" 2>/dev/null; then
        :
    elif mount -t configfs none "$USB_CONFIGFS_ROOT" 2>/dev/null && \
         grep -q " $USB_CONFIGFS_ROOT configfs " "$USB_PROC_MOUNTS" 2>/dev/null; then
        :
    else
        usb_hard_fail mount-failed
        return 1
    fi

    USB_BOUND=$(cat "$USB_GADGET/UDC" 2>/dev/null)
    if [ -n "$USB_BOUND" ] && [ "$USB_BOUND" != "$USB_UDC" ]; then
        USB_STAGE=bind
        usb_hard_fail "already-bound-to-$USB_BOUND"
        return 1
    fi
    if [ -z "$USB_BOUND" ]; then
        USB_STAGE=gadget-create
        if ! mkdir -p "$USB_GADGET/strings/0x409" \
            "$USB_GADGET/configs/c.1/strings/0x409" \
            "$USB_GADGET/functions/ncm.usb0" 2>/dev/null; then
            usb_hard_fail directory-create-failed
            return 1
        fi

        USB_STAGE=descriptors
        if ! usb_write "$USB_GADGET/idVendor" 0x1d6b || \
           ! usb_write "$USB_GADGET/idProduct" 0x0104 || \
           ! usb_write "$USB_GADGET/strings/0x409/product" r8q-mainline || \
           ! usb_write "$USB_GADGET/strings/0x409/manufacturer" Samsung || \
           ! usb_write "$USB_GADGET/strings/0x409/serialnumber" r8q0001; then
            usb_hard_fail "${USB_ERROR:-descriptor-write-failed}"
            return 1
        fi

        USB_STAGE=configuration
        if ! usb_write "$USB_GADGET/configs/c.1/strings/0x409/configuration" ncm; then
            usb_hard_fail "${USB_ERROR:-configuration-write-failed}"
            return 1
        fi
        USB_LINK=$USB_GADGET/configs/c.1/ncm.usb0
        if [ -e "$USB_LINK" ] || [ -L "$USB_LINK" ]; then
            :
        elif ! ln -s "$USB_GADGET/functions/ncm.usb0" "$USB_LINK" 2>/dev/null; then
            usb_hard_fail function-link-failed
            return 1
        fi
    fi

    USB_STAGE=bind
    if [ -z "$USB_BOUND" ] && ! usb_write "$USB_GADGET/UDC" "$USB_UDC"; then
        usb_hard_fail "${USB_ERROR:-bind-failed}"
        return 1
    fi
    sleep 2

    USB_STAGE=interface
    USB_IFACE_OK=0
    if ip addr show dev usb0 2>/dev/null | grep -q 'inet 172.16.42.1/24 '; then
        ip link set usb0 up 2>/dev/null && USB_IFACE_OK=1
    elif ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null; then
        USB_IFACE_OK=1
    elif ip link set usb0 up 2>/dev/null && \
         ip addr add 172.16.42.1/24 dev usb0 2>/dev/null; then
        USB_IFACE_OK=1
    fi
    if [ "$USB_IFACE_OK" -ne 1 ]; then
        usb_partial_fail usb0-setup-failed
    elif ! ip addr show dev usb0 2>/dev/null | grep -q 'inet 172.16.42.1/24 '; then
        usb_partial_fail usb0-address-not-172.16.42.1/24
    elif ! ip link show dev usb0 2>/dev/null | grep -Eq '<([^>]*,)?UP(,|>)'; then
        usb_partial_fail usb0-link-not-up
    fi

    USB_STAGE=devpts
    USB_DEVPTS_OK=0
    if ! mkdir -p "$USB_DEVPTS_ROOT" 2>/dev/null; then
        usb_partial_fail devpts-directory-create-failed
    elif grep -q " $USB_DEVPTS_ROOT devpts " "$USB_PROC_MOUNTS" 2>/dev/null; then
        USB_DEVPTS_OK=1
    elif mount -t devpts devpts "$USB_DEVPTS_ROOT" 2>/dev/null && \
         grep -q " $USB_DEVPTS_ROOT devpts " "$USB_PROC_MOUNTS" 2>/dev/null; then
        USB_DEVPTS_OK=1
    else
        usb_partial_fail devpts-mount-failed
    fi

    if [ "$USB_DEVPTS_OK" -eq 1 ]; then
        USB_STAGE=telnet
        if telnetd -l /bin/sh -b 172.16.42.1 2>/dev/null; then
            echo "TELNETD up on 172.16.42.1"
        else
            usb_partial_fail telnetd-launch-failed
        fi
    fi

    USB_STAGE=complete
    [ "$USB_RESULT" = waiting ] && USB_RESULT=ready
    [ "$USB_RESULT" = ready ] && USB_ERROR=none
    usb_status
    return 0
}

# ---- wait for userdata (UFS is fast, but be patient), then switch_root --------
ROOT=""
REASON=""
case " $(cat /proc/cmdline) " in
    *" r8q.debug=1 "*) REASON="kernel diagnostic mode (userdata mount skipped)" ;;
    *)
        i=0
        while [ $i -lt 20 ]; do
            ROOT=$(findpart userdata); [ -n "$ROOT" ] && break
            sleep 1; i=$((i+1))
        done
        [ -n "$ROOT" ] || REASON="userdata partition never appeared"
        ;;
esac
mkdir -p /newroot
if [ -z "$REASON" ]; then
    MOUT=$(mount -t ext4 "$ROOT" /newroot 2>&1) || REASON="ext4 mount of $ROOT failed: $MOUT"
fi
if [ -z "$REASON" ] && [ ! -x /newroot/usr/lib/systemd/systemd ]; then
    REASON="no systemd in rootfs (contents: $($BB ls /newroot 2>/dev/null | $BB tr '\n' ' '))"
fi

{ echo "=== switch_root attempt uptime $($BB cut -d' ' -f1 /proc/uptime)s root=$ROOT reason='${REASON:-ok}' ==="; } | esp_log switchroot.txt

if [ -z "$REASON" ]; then
    mount -t devtmpfs devtmpfs /newroot/dev 2>/dev/null
    echo "## userdata=$ROOT OK — switch_root -> systemd in 2s"
    sleep 2
    umount /sys/kernel/debug 2>/dev/null
    umount /proc 2>/dev/null; umount /sys 2>/dev/null
    # exec is MANDATORY: switch_root must become PID 1.
    exec switch_root /newroot /usr/lib/systemd/systemd
    REASON="exec switch_root returned (should be impossible)"
fi

# ---- FAILURE: debug mode -------------------------------------------------------
mount -t proc proc /proc 2>/dev/null; mount -t sysfs sysfs /sys 2>/dev/null
echo "!! ARCH BOOT FAILED: $REASON"
{ echo "FAIL uptime $($BB cut -d' ' -f1 /proc/uptime)s: $REASON"; dmesg | tail -40; } | esp_log switchroot-fail.txt
setup_gadget
i=0
while true; do
    echo "==== [arch-fail hb $i uptime $($BB cut -d' ' -f1 /proc/uptime)s] root='$ROOT' REASON: $REASON ===="
    usb_status
    i=$((i+1)); sleep 20
done
